<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>XpSearch.Core</RootNamespace>
    <AssemblyName>XpSearch.Core</AssemblyName>
    <PackageId>YourCo.Xperience.Search.Core</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Kentico.Xperience.WebApp" />
    <PackageReference Include="Kentico.Xperience.Lucene.Core" />
    <PackageReference Include="Lucene.Net.Highlighter" />
    <PackageReference Include="Lucene.Net.QueryParser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Xperience only scans an assembly marked discoverable for the analytics module class, its query
         log object type and the retention scheduled task:
         https://docs.kentico.com/documentation/developers-and-admins/customization/integrate-custom-code -->
    <AssemblyAttribute Include="CMS.AssemblyDiscoverableAttribute" />
  </ItemGroup>

</Project>
