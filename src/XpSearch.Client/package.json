{
  "name": "@yourco/xperience-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Xperience Search JavaScript client.",
  "sideEffects": false,
  "main": "./dist/xpsearch.umd.js",
  "module": "./dist/xpsearch.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/xpsearch.mjs",
      "default": "./dist/xpsearch.umd.js"
    },
    "./behaviors": {
      "types": "./dist/types/behaviors.d.ts",
      "import": "./dist/behaviors.mjs",
      "default": "./dist/behaviors.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "contract:gen": "node scripts/contract.mjs",
    "contract:check": "node scripts/contract.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "rollup -c && tsc -p tsconfig.build.json",
    "size": "node scripts/size.mjs",
    "mock": "node mock/server.ts",
    "docs:migration": "node scripts/migration-guide.mjs",
    "docs:check": "node scripts/migration-guide.mjs --check",
    "demo": "npm run build && node mock/demo-server.ts"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "quicktype": "26.0.0",
    "rollup": "4.62.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
