@using XpSearch.Widgets.Mounting
@model XpSearchMountViewModel
@*
    The only view the Page Builder widgets render (spec 7.1 / 7.5). Either the configured mount
    element, or - in Page Builder and preview only - an instruction block. On a live page an
    unconfigured widget renders nothing at all.
*@
@if (Model.Mount is not null)
{
    @Model.Mount
}
else if (Model.EditorMessage is not null)
{
    <div class="xps-widget-message" role="note">
        <strong class="xps-widget-message__title">@Model.EditorTitle</strong>
        <span class="xps-widget-message__text">@Model.EditorMessage</span>
    </div>
}
