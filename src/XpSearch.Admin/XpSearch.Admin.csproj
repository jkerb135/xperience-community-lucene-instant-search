<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>XpSearch.Admin</RootNamespace>
    <AssemblyName>XpSearch.Admin</AssemblyName>
    <PackageId>YourCo.Xperience.Search.Admin</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="CMS.AssemblyDiscoverableAttribute" />
  </ItemGroup>

  <ItemGroup>
    <!-- The §10.8 admin pages (API keys, index status, ingestion log) are pages over ingestion data,
         so Admin depends on Ingestion. See docs/adr/0014-relevance-tuning.md. -->
    <ProjectReference Include="..\XpSearch.Core\XpSearch.Core.csproj" />
    <ProjectReference Include="..\XpSearch.Ingestion\XpSearch.Ingestion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kentico.Xperience.Admin" />
    <PackageReference Include="Kentico.Xperience.Lucene.Admin" />
  </ItemGroup>

</Project>
