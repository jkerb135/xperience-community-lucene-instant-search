<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Relative to this file: samples/.feed, filled by samples/pack-and-build.mjs. -->
    <add key="xps-local" value="..\.feed" />
  </packageSources>
  <!-- Required, not optional, on any machine with package source mapping enabled globally:
       a <packageSource> alone still gives NU1101 because the mapping excludes the new source. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="xps-local">
      <package pattern="xperience-community.Xperience.Search.*" />
      <package pattern="XperienceCommunity.Search.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
