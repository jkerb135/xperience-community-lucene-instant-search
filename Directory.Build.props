<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>YourCo</Authors>
    <Product>Xperience Search</Product>
    <RepositoryUrl>https://github.com/your-org/your-monorepo</RepositoryUrl>
    <!-- NU5104: Lucene.Net 4.8.0-beta00017 is the only version Kentico.Xperience.Lucene 15.0.5 accepts; a stable package must be allowed to depend on it. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

</Project>
